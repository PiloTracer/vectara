# Environment
ENVIRONMENT=development
AUTH_SECRET="dev-secret-key-123456"
allowed_origins=http://localhost:13000

# Docker Compose
COMPOSE_PROJECT_NAME=tools-iadata

# NextAuth URL Configuration
AUTH_URL=http://localhost:13000
AUTH_TRUST_HOST=true

# Postgres
DB_USER=dl_admin
DB_PASSWORD=password
DB_NAME=datalake
DB_HOST=pg-dl
DB_PORT=5432
DB_HOST_PORT=15435

# Qdrant
QDRANT_HOST=ia-dl
QDRANT_PORT=16333

# Application Ports
FRONT_PORT=13000
BACK_PORT=18080

# Backups
BACKUP_DIR=./backups
IMPORT_DIR=./data/import

# Identifiers
DEPLOY_SUFFIX=dl_dev
DATA_SOURCES_DIR=/mnt/data/tmp/datos

# Authentication
AUTH_ISSUER_BASE=http://localhost:18090
AUTH_REALM="[realm name]"
AUTH_CLIENT_ID="[your service client id]"
AUTH_CLIENT_SECRET="[generated secret]"

# LLM & Local AI
USE_LOCAL_EMBEDDING=false
OLLAMA_HOST=host.docker.internal

# Chat Model (Multilingual)
LOCAL_MODEL_NAME=qwen2.5

# Embedding Model (Vectors)
LOCAL_EMBEDDING_MODEL_NAME=bge-m3

# OAuth Configuration
# Ensure these match the redirect URIs configured in Google Cloud Console and Azure Portal
# They must use the external BACK_PORT (default 18080), not the internal container port (8000)
GOOGLE_CLIENT_ID="[your-google-client-id]"
GOOGLE_CLIENT_SECRET="[your-google-client-secret]"
GOOGLE_REDIRECT_URI=http://localhost:18080/oauth/google/callback

MS_CLIENT_ID="[your-sp-client-id]"
MS_CLIENT_SECRET="[your-sp-client-secret]"
MS_TENANT_ID="[your-sp-tenant-id]"
MS_REDIRECT_URI=http://localhost:18080/oauth/microsoft/callback